# Copy this file to .env. Never commit the real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

MEETING_AGENT_DB=data/meeting_agent.db
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:8000

# Encrypts connected-account tokens before SQLite storage. Use 32+ random characters.
OAUTH_ENCRYPTION_KEY=

# Create OAuth apps in each provider console and register these callbacks:
# http://localhost:8000/integrations/google/callback
# http://localhost:8000/integrations/slack/callback
# http://localhost:8000/integrations/microsoft/callback
# http://localhost:8000/integrations/zoom/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
