# Copy this file to .env. Never commit the real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Fast conversational answers; OPENAI_MODEL above remains the minutes model.
OPENAI_ANSWER_MODEL=gpt-6-luna

ELEVENLABS_API_KEY=
# Charlie: built-in Australian English male voice.
ELEVENLABS_VOICE_ID=IKne3meq5aSn9XLyUdCD
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

MEETING_AGENT_DB=data/meeting_agent.db
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:8000

# One trusted demo operator. Generate with: openssl rand -hex 32
# Send as Authorization: Bearer <token>. Never put provider keys in frontend code.
BACKEND_API_TOKEN=

# Recall workspace: Alloy Bot / Asia Pacific (Tokyo). These are backend-only.
RECALL_REGION=ap-northeast-1
RECALL_API_KEY=
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Stable public HTTPS backend origin, e.g. reserved ngrok domain (not localhost).
PUBLIC_API_BASE_URL=
# Optional alternate HTTPS origin for the bot webpage; must reach this same backend.
# Useful when the primary tunnel has a browser interstitial. Temporary URLs: demos only.
RECALL_MEDIA_BASE_URL=
# EXACT regional_callback_uri returned by Recall calendar setup; do not invent.
RECALL_CALENDAR_CALLBACK_URI=

# Encrypts connected-account tokens before SQLite storage. Use 32+ random characters.
OAUTH_ENCRYPTION_KEY=

# Create OAuth apps in each provider console and register these callbacks:
# http://localhost:8000/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional urgent questions + authorized owner reply relay (no Discord voice yet).
# Enable Message Content intent in the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ESCALATION_CHANNEL_ID=
DISCORD_OWNER_USER_ID=

# Shared estimated OpenAI + ElevenLabs usage; local calendar months.
AI_MONTHLY_SOFT_LIMIT_USD=5
AI_MONTHLY_HARD_LIMIT_USD=8
AI_BUDGET_TIMEZONE=Asia/Kuala_Lumpur
