# Copy to apps/web/.env.local (git-ignored) and fill in.
# Server-only: never prefix these with NEXT_PUBLIC_. See docs/BACKEND_HANDOFF.md.

# Where the Alloy backend runs. Use http://127.0.0.1:8000 only when it's on this machine;
# otherwise ask the backend operator for the current HTTPS tunnel URL.
ALLOY_BACKEND_URL=http://127.0.0.1:8000

# The same value as BACKEND_API_TOKEN in the backend's .env. Share it privately.
BACKEND_API_TOKEN=

# Optional: time zone for dates and times on the dashboard.
DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
